{
  "name": "mini-dropbox-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "REST API + static frontend host. Thin HTTP client of the gRPC backend.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-public",
    "copy-public": "node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "@grpc/grpc-js": "^1.10.9",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17"
  }
}
