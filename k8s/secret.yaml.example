# Copy to secret.yaml, fill in real values, and DO NOT commit secret.yaml.
# Generate MASTER_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# If the cluster isn't using IRSA / an IAM role for the pod's service
# account, also add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here for the
# S3 replica leg. Prefer IRSA (EKS) over long-lived keys when possible.
apiVersion: v1
kind: Secret
metadata:
  name: mini-dropbox-secrets
  namespace: mini-dropbox
type: Opaque
stringData:
  MASTER_KEY: "REPLACE_WITH_64_CHAR_HEX_STRING"
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
